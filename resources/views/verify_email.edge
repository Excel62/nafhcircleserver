<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Verify Your Email</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Segoe UI', Arial, sans-serif; background-color: #0f0f0f; color: #ffffff; }
    .wrapper { max-width: 600px; margin: 0 auto; padding: 40px 20px; }
    .card { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); border: 1px solid #d4af37; border-radius: 16px; overflow: hidden; }
    .header { background: linear-gradient(90deg, #d4af37, #00bcd4); padding: 32px; text-align: center; }
    .header img { height: 60px; width: auto; margin-bottom: 12px; }
    .header h1 { color: #000000; font-size: 24px; font-weight: 700; letter-spacing: 1px; }
    .body { padding: 40px 32px; }
    .greeting { font-size: 18px; color: #ffffff; margin-bottom: 16px; }
    .message { font-size: 14px; color: #a0a0b0; line-height: 1.7; margin-bottom: 32px; }
    .code-section { background: rgba(212, 175, 55, 0.08); border: 1px dashed #d4af37; border-radius: 12px; padding: 24px; text-align: center; margin-bottom: 32px; }
    .code-label { font-size: 12px; color: #a0a0b0; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 12px; }
    .code { font-size: 42px; font-weight: 700; letter-spacing: 12px; color: #d4af37; font-family: 'Courier New', monospace; }
    .code-expiry { font-size: 12px; color: #a0a0b0; margin-top: 12px; }
    .divider { height: 1px; background: rgba(255,255,255,0.08); margin: 24px 0; }
    .warning { background: rgba(255, 87, 87, 0.08); border-left: 3px solid #ff5757; border-radius: 4px; padding: 12px 16px; font-size: 13px; color: #ff9090; line-height: 1.6; margin-bottom: 24px; }
    .footer { padding: 24px 32px; text-align: center; background: rgba(0,0,0,0.3); }
    .footer p { font-size: 12px; color: #606070; line-height: 1.7; }
    .footer a { color: #d4af37; text-decoration: none; }
    .social { margin-top: 16px; }
    .social a { display: inline-block; margin: 0 6px; color: #00bcd4; font-size: 12px; text-decoration: none; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="card">

      <!-- Header -->
      <div class="header">
        <h1>NAFH Circle</h1>
      </div>

      <!-- Body -->
      <div class="body">
        <p class="greeting">Hello, {{ name }} 👋</p>
        <p class="message">
          Thank you for creating your NAFH Circle account. To complete your registration
          and start your journey, please verify your email address using the code below.
        </p>

        <!-- Code Box -->
        <div class="code-section">
          <p class="code-label">Your Verification Code</p>
          <p class="code">{{ code }}</p>
          <p class="code-expiry">⏱ This code expires in <strong style="color:#d4af37">10 minutes</strong></p>
        </div>

        <div class="warning">
          🔒 <strong>Security Notice:</strong> Never share this code with anyone.
          NAFH Circle will never ask for your verification code via phone, chat, or email.
        </div>

        <div class="divider"></div>

        <p class="message">
          If you did not create an account with NAFH Circle, you can safely ignore this email.
          No action is required on your part.
        </p>
      </div>

      <!-- Footer -->
      <div class="footer">
        <p>© {{ new Date().getFullYear() }} NAFH Circle. All rights reserved.</p>
        <p style="margin-top: 8px;">
          <a href="#">Privacy Policy</a> &nbsp;·&nbsp;
          <a href="#">Terms of Service</a> &nbsp;·&nbsp;
          <a href="#">Support</a>
        </p>
        <div class="social">
          <a href="#">Telegram</a>
          <a href="#">Twitter</a>
          <a href="#">Website</a>
        </div>
      </div>

    </div>

    <p style="text-align:center; font-size:11px; color:#404050; margin-top:20px;">
      This email was sent to {{ email }}. If you have questions, contact
      <a href="mailto:support@nafhcircle.com" style="color:#d4af37;">support@nafhcircle.com</a>
    </p>
  </div>
</body>
</html>